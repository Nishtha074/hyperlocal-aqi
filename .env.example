# PostgreSQL Database Connection
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/hyperlocal_aqi

# Data.gov.in API (For CPCB Air Quality Data)
# You can get an API key by registering at data.gov.in
DATA_GOV_API_KEY=your_api_key_here
DATA_GOV_RESOURCE_ID=your_resource_id_here
CPCB_STATE=Maharashtra
CPCB_CITY=Pune

# Alert evaluation runs while the FastAPI backend is running.
ALERT_EVALUATION_INTERVAL_SECONDS=300
ALERT_MAX_OBSERVATION_AGE_MINUTES=180

# No notification delivery adapter is implemented yet. Leave empty.
NOTIFICATION_PROVIDER=
